# Postgres connection string (e.g. from Neon, Supabase, or local Postgres).
# If using Neon: use the *pooled* connection string (host has a "-pooler"
# suffix) — the unpooled one exhausts its connection limit quickly under
# dev-server hot reload or serverless traffic.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required for the AI expense parser, assistant chat, and weekly summaries.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional Google OAuth (leave blank to only use email/password sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
