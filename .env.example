# Local dev default: SQLite, zero setup.
# To switch to Postgres later: change provider in prisma/schema.prisma to
# "postgresql" and set this to a real connection string, e.g.
# postgresql://user:password@localhost:5432/budgetiq
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required for the AI expense parser, assistant chat, and weekly summaries.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional Google OAuth (leave blank to only use email/password sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
