// BudgetIQ Student — Prisma schema
//
// Local dev runs on SQLite (zero setup). Every model here is written to be
// Postgres-compatible: no SQLite-only types are used, so switching providers
// later is just:
//   1. change `provider = "sqlite"` -> `provider = "postgresql"` below
//   2. point DATABASE_URL at a real Postgres instance
//   3. `npx prisma migrate dev`
// See README.md for the full migration note.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth / Auth.js credentials + optional OAuth) ---------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  image         String?
  emailVerified DateTime?

  monthlyBudget Float  @default(0)
  currency      String @default("Rs.")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  transactions   Transaction[]
  categoryLimits CategoryBudget[]
  savingsGoals   SavingsGoal[]
  weeklyReports  WeeklyReport[]
  financialScores FinancialScore[]
  chatMessages   ChatMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Core budgeting domain ---------------------------------------------
//
// `category` is stored as a plain String rather than a Prisma enum: SQLite
// has no native enum support, so keeping this a validated string (see
// src/lib/categories.ts for the canonical list + Zod schema) keeps the
// model portable across both providers.

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  category    String
  description String
  rawInput    String? // original natural-language text, e.g. "spent 850 on coffee"
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
}

model CategoryBudget {
  id          String @id @default(cuid())
  userId      String
  category    String
  monthlyCap  Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  emoji         String    @default("🎯")
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  amount    Float
  date      DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model WeeklyReport {
  id              String   @id @default(cuid())
  userId          String
  weekStart       DateTime
  weekEnd         DateTime
  summary         String
  insights        String // JSON-encoded string[]
  recommendations String // JSON-encoded string[]
  totalSpent      Float
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

model FinancialScore {
  id                    String   @id @default(cuid())
  userId                String
  score                 Int
  budgetAdherence       Float
  savingsHabit          Float
  overspendingFrequency Float
  goalProgress          Float
  date                  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
